<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <!-- Appenders: Define where logs should be displayed -->

    <Appenders>

        <!-- Console Appender -->
        <Console name="Console" target="SYSTEM_OUT">

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level [%t] %c{1} - %msg%n"/>

        </Console>

        <!-- File Appender -->
        <File name="File" fileName="logs/automation.log" append="true">

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level [%t] %c{1} - %msg%n"/>

        </File>

    </Appenders>

    <!-- Logger Configuration -->

    <Loggers>

        <Root level="info">

            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>

        </Root>

    </Loggers>

</Configuration>